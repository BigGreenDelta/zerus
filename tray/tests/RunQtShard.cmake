# Run one shard of a QtTest suite, so that a long suite runs as several parallel
# CTest tests. A function that SEED lists by data row runs as separate rows
# (function:tag). Functions and rows with a SEED duration go to the least loaded
# shard, longest first; the others go by a hash of their name, so a new test runs
# in one shard without moving the rest. Every shard plans all shards and fails
# unless each listed function or row runs in exactly one of them.
# Usage: cmake -DTEST=<binary> -DSUITE=<name in SEED> -DSEED=<durations file>
#        -DSHARD=<0..SHARDS-1> -DSHARDS=<n> [-DRESULTS=<directory>] -P RunQtShard.cmake
# SEED lines are "<suite> <milliseconds> <function>[:<data tag>]"; with RESULTS the
# shard also writes its QtTest JUnit results there as <suite>-<shard>.xml.
cmake_minimum_required(VERSION 3.16)

# How a run ended, for the failure message. CMake reports crashes as text
# ("Segmentation fault", "Access violation", "Exit code 0xc0000409") and other
# Windows status codes as large or negative numbers, shown here as hex NTSTATUS.
function(describe_exit status out)
    string(STRIP "${status}" status)
    if(status MATCHES "^-[0-9]+$")
        math(EXPR status "${status} + 0x100000000" OUTPUT_FORMAT HEXADECIMAL)
    elseif(status MATCHES "^[0-9]+$" AND status GREATER 255)
        math(EXPR status "${status}" OUTPUT_FORMAT HEXADECIMAL)
    endif()
    set(${out} "${status}" PARENT_SCOPE)
endfunction()

# The lines of text as a list. A list separator, bracket or backslash would change
# how CMake splits it, so they become the character in ${unsafe}.
string(ASCII 1 unsafe)
function(split_lines text out)
    string(REPLACE "\r" "" text "${text}")
    foreach(special IN ITEMS ";" "[" "]" "\\")
        string(REPLACE "${special}" "${unsafe}" text "${text}")
    endforeach()
    string(REPLACE "\n" ";" text "${text}")
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# "<class> <function>" per function without data, "<class> <function> <tag>" per row.
execute_process(COMMAND "${TEST}" -datatags OUTPUT_VARIABLE listing RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    describe_exit("${status}" exit)
    message(FATAL_ERROR "Could not list the test functions of ${TEST} (exit status: ${exit})")
endif()
# QtTest ends the function name at a colon: a function with such a tag, a tag
# CMake cannot keep in a list, an empty tag, a tag outside printable ASCII (Windows
# passes arguments in the ANSI code page) or global data runs whole.
split_lines("${listing}" lines)
set(functions)
set(rows)
foreach(line IN LISTS lines)
    if(NOT line MATCHES "^[^ ]+ ([A-Za-z_][A-Za-z0-9_]*)( (.*))?$")
        continue()
    endif()
    set(function "${CMAKE_MATCH_1}")
    set(tag "${CMAKE_MATCH_3}")
    if(NOT function IN_LIST functions)
        list(APPEND functions ${function})
    endif()
    if("${CMAKE_MATCH_2}" STREQUAL "")
        continue()
    elseif(tag STREQUAL "" OR tag MATCHES "[^ -~]|:|(^| )__global__ ")
        set(whole_${function} TRUE)
    elseif(NOT "${function}:${tag}" IN_LIST rows)
        list(APPEND tags_${function} "${tag}")
        list(APPEND rows "${function}:${tag}")
    endif()
endforeach()
list(LENGTH functions count)
if(count EQUAL 0)
    message(FATAL_ERROR "${TEST} listed no test functions")
endif()

set(seeded)
set(durations)
set(by_row)
file(READ "${SEED}" seed)
split_lines("${seed}" entries)
foreach(entry IN LISTS entries)
    if(entry MATCHES "^${SUITE} ([0-9]+) (([A-Za-z_][A-Za-z0-9_]*)(:.+)?)$")
        list(APPEND seeded "${CMAKE_MATCH_2}")
        list(APPEND durations ${CMAKE_MATCH_1})
        if(NOT "${CMAKE_MATCH_4}" STREQUAL "")
            list(APPEND by_row ${CMAKE_MATCH_3})
        endif()
    endif()
endforeach()

# Known items as "<10^9 + milliseconds> <item>": a descending sort puts the
# longest first, in the same order on every platform.
set(known)
set(unknown)
foreach(function IN LISTS functions)
    list(LENGTH tags_${function} count)
    if(function IN_LIST by_row AND count GREATER 0 AND NOT whole_${function})
        set(items)
        foreach(tag IN LISTS tags_${function})
            list(APPEND items "${function}:${tag}")
        endforeach()
    else()
        set(items ${function})
    endif()
    foreach(item IN LISTS items)
        list(FIND seeded "${item}" index)
        if(index EQUAL -1)
            list(APPEND unknown "${item}")
        else()
            list(GET durations ${index} duration)
            math(EXPR key "1000000000 + ${duration}")
            list(APPEND known "${key} ${item}")
        endif()
    endforeach()
endforeach()
list(SORT known ORDER DESCENDING)

math(EXPR last "${SHARDS} - 1")
foreach(shard RANGE ${last})
    set(load_${shard} 0)
    set(shard_${shard})
endforeach()
foreach(entry IN LISTS known)
    string(REGEX MATCH "^([0-9]+) (.*)$" entry "${entry}")
    set(item "${CMAKE_MATCH_2}")
    math(EXPR duration "${CMAKE_MATCH_1} - 1000000000")
    set(least 0)
    foreach(shard RANGE ${last})
        if(load_${shard} LESS load_${least})
            set(least ${shard})
        endif()
    endforeach()
    math(EXPR load_${least} "${load_${least}} + ${duration}")
    list(APPEND shard_${least} "${item}")
endforeach()
foreach(item IN LISTS unknown)
    string(MD5 hash "${item}")
    string(SUBSTRING "${hash}" 0 6 prefix)
    math(EXPR slot "0x${prefix} % ${SHARDS}")
    list(APPEND shard_${slot} "${item}")
endforeach()

# Every listed function, or each of its rows, runs in exactly one shard.
set(planned)
foreach(shard RANGE ${last})
    list(APPEND planned ${shard_${shard}})
endforeach()
set(errors)
set(seen)
foreach(item IN LISTS planned)
    if(item IN_LIST seen)
        list(APPEND errors "${item} runs in more than one shard")
    elseif(NOT item IN_LIST functions AND NOT item IN_LIST rows)
        list(APPEND errors "${item} is not a listed function or data row")
    endif()
    list(APPEND seen "${item}")
endforeach()
foreach(function IN LISTS functions)
    list(LENGTH tags_${function} count)
    if(function IN_LIST planned)
        foreach(tag IN LISTS tags_${function})
            if("${function}:${tag}" IN_LIST planned)
                list(APPEND errors "${function}:${tag} also runs with the whole function")
            endif()
        endforeach()
    elseif(count EQUAL 0 OR whole_${function})
        list(APPEND errors "${function} runs in no shard")
    else()
        foreach(tag IN LISTS tags_${function})
            if(NOT "${function}:${tag}" IN_LIST planned)
                list(APPEND errors "${function}:${tag} runs in no shard")
            endif()
        endforeach()
    endif()
endforeach()
if(errors)
    list(JOIN errors "\n  " errors)
    message(FATAL_ERROR "The ${SHARDS} shards of ${TEST} must run each test exactly once:\n  ${errors}")
endif()

list(LENGTH shard_${SHARD} count)
if(count GREATER 0)
    set(results)
    if(RESULTS)
        file(MAKE_DIRECTORY "${RESULTS}")
        set(results -o "${RESULTS}/${SUITE}-${SHARD}.xml,junitxml" -o -,txt)
    endif()
    execute_process(COMMAND "${TEST}" ${shard_${SHARD}} ${results} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        describe_exit("${status}" exit)
        message(FATAL_ERROR "${TEST} shard ${SHARD} of ${SHARDS} failed (exit status: ${exit})")
    endif()
endif()
