// Shared build settings for the Zerus iOS app. Values that identify a signing
// team or device stay in the ignored Local.xcconfig (see Local.xcconfig.example).

PRODUCT_NAME = Zerus
PRODUCT_BUNDLE_IDENTIFIER = app.zerus.mobile
CODE_SIGN_ENTITLEMENTS = Config/Zerus.entitlements
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Zerus
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIRequiresFullScreen = NO
INFOPLIST_KEY_NSCameraUsageDescription = Zerus uses the camera to scan pairing invitations, take photos you attach, and record video messages you choose to send.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Zerus uses the microphone to record voice and video messages you choose to send.

// The marketing version must equal mobile/ios/DEV_VERSION (checked by
// scripts/ci/check-source.py). Build scripts pass the CI sequence as the build.
MARKETING_VERSION = 0.3.1
CURRENT_PROJECT_VERSION = 0
ZERUS_BUILD_CHANNEL = local
ZERUS_SOURCE_REVISION = unknown

// The APNs environment follows each channel's signing, not its configuration:
// local builds carry development profiles even in Release, while TestFlight and
// App Store exports re-sign for production. The relay provider follows it.
ZERUS_APNS_ENVIRONMENT = $(ZERUS_APNS_ENVIRONMENT_$(ZERUS_BUILD_CHANNEL))
ZERUS_APNS_ENVIRONMENT_local = development
ZERUS_APNS_ENVIRONMENT_dev = production
ZERUS_APNS_ENVIRONMENT_stable = production

IPHONEOS_DEPLOYMENT_TARGET = 18.0
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_PREVIEWS = YES
DEAD_CODE_STRIPPING = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(ZERUS_DEVELOPMENT_TEAM)

#include? "Local.xcconfig"
