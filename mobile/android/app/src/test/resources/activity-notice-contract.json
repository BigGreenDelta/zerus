      "name": "hgs sender envelope from another agent",
      "prompt": "<zerus-message from=\"claude/p/review\" host=\"arch\" reference=\"zerus://session?machine=11111111-1111-4111-8111-111111111111&amp;host=arch&amp;name=claude%2Fp%2Freview&amp;conversation=c&amp;run=r\">\nThe patch is ready.\n\n- tests pass\n</zerus-message>",
      "event": {
        "type": "UserPromptSubmit",
        "agent_id": "",
        "origin": "peer_message",
        "detail": "Message from claude/p/review",
        "report": "The patch is ready.\n\n- tests pass",
        "sender": "claude/p/review",
        "sender_reference": "zerus://session?machine=11111111-1111-4111-8111-111111111111&host=arch&name=claude%2Fp%2Freview&conversation=c&run=r"
      },
      "presentation": {
        "kind": "notice",
        "label": "Message from claude/p/review",
        "body": "The patch is ready.\n\n- tests pass",
        "report": ""
      }
